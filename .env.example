# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:pass@ep-xyz.ap-southeast-1.aws.neon.tech/eldercare?sslmode=require

# Security / Auth
JWT_SECRET=change-this-to-a-secure-random-secret
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Timezone & Simulation
TZ_LOCAL=Asia/Jakarta
SIM_TICK_SECONDS=3
INACTIVITY_MIN=90

# LLM Smart Report (Gemini or Groq)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# File Storage (Optional Supabase Storage; fallback is local ./uploads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# Optional Port
PORT=8000
